# Response headers for Cloudflare static assets.
#
# Everything under /_astro/ is fingerprinted by the build (the file name
# changes whenever the contents do), so a browser can keep it for a year
# and never ask again. Cloudflare's default is max-age=0, which makes every
# page view revalidate every stylesheet, script and font.
#
# Photographs are not fingerprinted, so they get a week: long enough to make
# repeat visits fast, short enough that a replaced photo shows up.
#
# HTML is left at Cloudflare's default so a push is live straight away.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=604800
