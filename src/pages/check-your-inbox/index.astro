---
/**
 * Where a reader lands the instant they submit the signup form, before they
 * have confirmed anything. Set in the Kit form settings under "After a visitor
 * subscribes", as a REDIRECT rather than a success message.
 *
 * Why a page rather than Kit's inline success message. Our forms carry no
 * JavaScript and post straight to Kit, so the browser follows Kit's response.
 * Left alone that means somebody who just handed their address to a Sumner
 * County nonprofit lands on a Kit branded page at a kit.com address. A redirect
 * keeps them on our own site, where they can see who they just gave it to.
 *
 * NOT the same page as /thank-you/. That one is for AFTER the confirm link is
 * clicked, when the person is actually subscribed. This one is the waypoint in
 * between, and its whole job is to say the thing is not finished yet.
 *
 * noindex. A page that only makes sense seconds after submitting a form has no
 * business turning up cold in a search result.
 */
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { org } from "../../site.config";
---

<Base
  title="Check Your Inbox"
  description="One more step to join the list for word from the Latimer House."
  noindex
>
  <PageHero
    crumbs={[{ label: "Check Your Inbox" }]}
    headline="Check your inbox."
    lead="We have sent you an email with a link in it. Click the link and you are on the list. Until you do, nothing has happened, and we will not send you anything."
    image="/img/house-hero"
    imageAlt="A two storey hand hewn log house with a stone chimney, standing in grass behind a split rail fence."
  />
  <section class="band band--parchment torn-top">
    <div class="container">
      <div class="ty">
        <div class="ty__col" data-aos="fade-up">
          <p class="eyebrow">What to do now</p>
          <div class="stack measure ty__body">
            <p>
              Open the email titled <strong>One more step</strong>, from the
              Friends of the Latimer House, and click the button inside it. That
              is the whole of it.
            </p>
            <p>
              We ask for the extra click because a list nobody agreed to join is
              not worth having. It also means the only people who hear from us
              are the ones who meant to.
            </p>
          </div>
        </div>

        <div class="ty__col" data-aos="fade-up" data-aos-delay="150">
          <p class="eyebrow">If it does not arrive</p>
          <div class="stack measure ty__body">
            <p>
              Give it a minute, then look in spam or promotions. It comes from
              <strong>news@friendsofthelatimerhouse.org</strong>, and adding that
              to your contacts keeps the rest of our mail out of the same place.
            </p>
            <p>
              If it never turns up, write to
              <a href={`mailto:${org.email}`}>{org.email}</a> and a board member
              will sort it out.
            </p>
            <p class="ty__actions">
              <a class="btn btn--primary" href="/the-story/">
                Read the story while you wait
                <span class="btn__arrow" aria-hidden="true">&rarr;</span>
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .band { padding-block: clamp(3.5rem, 2.25rem + 5vw, 6rem); }

  /* Two columns that become one at narrow widths, with no guessed breakpoint:
     the columns simply stop fitting and reflow. Same construction as both
     thank you pages, deliberately. */
  .ty {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
    gap: clamp(2rem, 1.25rem + 3vw, 4rem);
  }

  .ty__body { margin-block-start: 1rem; }
  .ty__body p { color: var(--text-secondary); }
  .ty__body strong { color: var(--text-primary); font-weight: 600; }

  /* :not(.btn) matters. Without it this underlines the button too, because the
     button is an anchor inside a paragraph. */
  .ty__body p a:not(.btn) {
    color: var(--forest-900);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  .ty__body p a:not(.btn):hover { color: var(--hewn-600); }

  /* The button carries its own hover transition, so the reveal animation goes
     on this wrapper instead. See the rule in global.css. */
  .ty__actions { margin-block-start: 1.75rem; }
</style>
