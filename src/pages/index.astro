---
import Base from "../layouts/Base.astro";
import { org } from "../site.config";
---

<Base title="Friends of the Latimer House" bare>
  <section class="hero">
    <div class="container hero__inner">
      <p class="eyebrow hero__eyebrow">Sumner County, Tennessee</p>
      <h1 class="t-display">There is a log house inside this brick house.</h1>
      <p class="lead hero__lead measure">
        Charles Latimer cut the timber on this ground and raised the house in
        the 1790's. A century later somebody covered it in brick. In May 2025
        the brick started coming off, and the logs are still there.
      </p>
      <p class="hero__beats">
        The Latimers built it. The Browns saved it. The neighbors keep it.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/the-story/">
          See the house <span class="btn__arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a class="btn btn--secondary hero__secondary" href="/give/">Help uncover it</a>
      </div>
    </div>
  </section>
  <div class="torn-edge" aria-hidden="true"></div>

  <section class="band band--parchment">
    <div class="container">
      <p class="eyebrow">Why we are here</p>
      <h2>A house does not survive two hundred years by accident.</h2>
      <p class="lead measure" style="margin-block-start:1rem">
        It survives because somebody keeps deciding it should. For most of the
        last ten years nothing happened here. In 2026 the county commission
        voted to place the house with an organization built to look after it,
        and that is us. We would be glad of your company.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: var(--forest-950);
    color: var(--parchment-200);
    padding-block: clamp(3.5rem, 2rem + 7vw, 8rem);
    padding-block-end: clamp(5rem, 3rem + 8vw, 9rem);
  }
  .hero__eyebrow { color: var(--hewn-300); }
  .hero h1 {
    color: var(--parchment-50);
    max-width: 18ch;
    margin-block-start: 1.25rem;
  }
  .hero__lead { color: var(--parchment-200); margin-block-start: 1.5rem; }
  .hero__beats {
    margin-block-start: 1.75rem;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--type-label-size);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--parchment-100);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-block-start: 2.25rem;
  }
  .hero__secondary { color: var(--parchment-100); }
  .hero__secondary:hover {
    background: var(--parchment-100);
    color: var(--forest-950);
    border-color: var(--parchment-100);
  }
</style>
