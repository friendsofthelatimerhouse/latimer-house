---
/**
 * Home. Built to the Figma frame "Home · Full Bleed" (92:58), the primary
 * of the three concepts.
 *
 * Three parts, in this order: a full bleed hero photograph with the
 * header floating on it, a torn edge, and the newsletter band. The
 * footer comes from the layout. There is no separate mission band on
 * this page; the mission line lives inside the newsletter band, as it
 * does on the canvas.
 */
import Base from "../layouts/Base.astro";
import { newsletter, give } from "../site.config";

const signupReady = Boolean(newsletter.action);
---

<Base title="Friends of the Latimer House" bare overlayHeader>
  <section class="hero">
    <picture class="hero__media">
      <source
        type="image/webp"
        srcset="/img/house-hero-700.webp 700w, /img/house-hero-1000.webp 1000w, /img/house-hero-1440.webp 1440w, /img/house-hero-2000.webp 2000w"
        sizes="100vw"
      />
      <img
        src="/img/house-hero-1440.jpg"
        srcset="/img/house-hero-700.jpg 700w, /img/house-hero-1000.jpg 1000w, /img/house-hero-1440.jpg 1440w, /img/house-hero-2000.jpg 2000w"
        sizes="100vw"
        alt="A two storey hand hewn log house with a stone chimney, standing in grass behind a split rail fence."
        width="2441"
        height="1489"
        fetchpriority="high"
      />
    </picture>

    <!-- Two scrims, both from the canvas. The left to right one carries
         the copy; the top down one keeps the navigation legible against
         a bright sky. Dark scrim under light type, never the reverse. -->
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="hero__scrim hero__scrim--top" aria-hidden="true"></div>

    <div class="container hero__inner">
      <div class="hero__copy">
        <h1 class="hero__headline" data-aos="fade-up">
          Revolutionary<br />history<br />lives here.
        </h1>
        <hr class="hero__rule" data-aos="fade-up" data-aos-delay="150" />
        <p class="hero__body" data-aos="fade-up" data-aos-delay="300">
          Charles Latimer cut the timber on this ground and raised the house
          in the 1790's. A century later somebody covered it in brick. In May
          2025 the brick started coming off, and the logs are still there.
        </p>
        <p class="hero__kicker" data-aos="fade-up" data-aos-delay="450">
          The Latimers built it. The Browns saved it.<br />
          The neighbors keep it.
        </p>
        <p class="hero__actions" data-aos="fade-up" data-aos-delay="600">
          <a class="btn btn--hero" href={give.href}>
            Help uncover it <span class="btn__arrow" aria-hidden="true">&rarr;</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  <div class="torn-edge" aria-hidden="true"></div>

  <!-- The home signup band carries three things where the shared one
       carries two: the signup, and beside it the mission line and the
       gift invitation. This composition appears once, so it lives here
       rather than in a component. -->
  <section class="band-signup">
    <div class="container band-signup__inner">
      <div class="band-signup__intro" data-aos="fade-up">
        <span class="band-signup__disc" aria-hidden="true">
          <svg viewBox="0 0 24 18" width="22" height="16" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="1" y="1" width="22" height="16" rx="2" />
            <path d="M1.6 2.2 12 10 22.4 2.2" />
          </svg>
        </span>
        <span class="band-signup__introtext">
          <span class="band-signup__eyebrow">Stay connected</span>
          <span class="band-signup__note">
            What we uncover, when we are working, and how to join in.
          </span>
        </span>
      </div>

      <form
        class="band-signup__form"
        data-aos="fade-up"
        data-aos-delay="200"
        action={newsletter.action || undefined}
        method="post"
      >
        <label class="visually-hidden" for="home-email">Your email address</label>
        <input
          class="band-signup__field"
          id="home-email"
          type="email"
          name={newsletter.emailField}
          placeholder="Your email address"
          autocomplete="email"
          required
          disabled={!signupReady}
        />
        <button class="band-signup__submit" type="submit" disabled={!signupReady}>
          Sign up
        </button>
      </form>

      <div class="band-signup__mission" data-aos="fade-up" data-aos-delay="400">
        <p class="band-signup__descriptor">
          We are the nonprofit that looks after the Latimer House, a 1790's
          log house in Sumner County, Tennessee.
        </p>
        <p class="band-signup__ask">We would welcome your help.</p>
      </div>

      <a class="band-signup__give" href={give.href} data-aos="fade-up" data-aos-delay="600">
        <span class="band-signup__givedisc" aria-hidden="true">
          <svg viewBox="0 0 24 22" width="21" height="19" fill="currentColor">
            <path d="M12 21.3 3.3 12.6a5.6 5.6 0 1 1 7.9-7.9l.8.8.8-.8a5.6 5.6 0 1 1 7.9 7.9Z" />
          </svg>
        </span>
        <span class="band-signup__givetext">Help<br />uncover it</span>
      </a>
    </div>
  </section>
</Base>

<style>
  /* ---------- HERO ---------- */

  .hero {
    position: relative;
    isolation: isolate;
    /* Pulled up under the floating header, then padded back down by the
       same amount so the copy sits where the canvas puts it. */
    margin-block-start: calc(var(--header-overlay-h) * -1);
    padding-block-start: var(--header-overlay-h);
    display: flex;
    align-items: flex-end;
    min-height: min(88svh, 54rem);
    color: var(--parchment-100);
    background: var(--forest-950);
    overflow: clip;
  }

  .hero__media { position: absolute; inset: 0; z-index: -2; }
  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The house sits right of center in the frame, so on a narrow screen
       the crop holds the building rather than the empty grass. */
    object-position: 62% 50%;
  }
  @media (max-width: 48rem) {
    .hero__media img { object-position: 58% 38%; }
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to right,
      rgb(8 28 19 / 0.96) 0%,
      rgb(8 28 19 / 0.72) 42%,
      rgb(8 28 19 / 0.18) 72%,
      rgb(8 28 19 / 0) 100%
    );
  }
  .hero__scrim--top {
    inset-block-end: auto;
    height: 300px;
    background: linear-gradient(
      to bottom,
      rgb(8 28 19 / 0.8) 0%,
      rgb(8 28 19 / 0) 100%
    );
  }
  /* On a phone the copy runs the full width, so the wash has to as well
     or the last words fall off the readable part of the picture. */
  @media (max-width: 48rem) {
    /* The vertical wash already darkens the top, so the second scrim
       only creates a visible seam where it ends. */
    .hero__scrim--top { display: none; }

    .hero__scrim {
      background: linear-gradient(
        to bottom,
        rgb(8 28 19 / 0.62) 0%,
        rgb(8 28 19 / 0.38) 34%,
        rgb(8 28 19 / 0.86) 72%,
        rgb(8 28 19 / 0.94) 100%
      );
    }
  }

  .hero__inner {
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 5rem) clamp(3.5rem, 2rem + 7vw, 7rem);
  }
  .hero__copy { max-width: 41rem; }

  .hero__headline {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    /* 68px at 1440 on the canvas, expressed as a ratio rather than the
       hard 70px line height, so it scales instead of squashing. */
    font-size: clamp(2.35rem, 1.2rem + 4.6vw, 4.25rem);
    line-height: 1.03;
    letter-spacing: -0.01em;
    color: var(--parchment-100);
  }

  .hero__rule {
    width: 72px;
    height: 3px;
    margin-block: 1.4rem;
    border: 0;
    background: var(--hewn-400);
  }

  .hero__body {
    max-width: 31rem;
    font-size: clamp(1rem, 0.94rem + 0.28vw, 1.1875rem);
    line-height: 1.72;
    color: var(--parchment-200);
  }

  .hero__kicker {
    margin-block-start: 1.25rem;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(0.8125rem, 0.77rem + 0.2vw, 0.9375rem);
    line-height: 1.7;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--parchment-100);
  }

  .hero__actions { margin-block-start: 2rem; }

  /* ---------- SIGNUP BAND ---------- */

  .band-signup {
    background: var(--parchment-100);
    color: var(--charcoal-800);
    padding-block: clamp(2.25rem, 1.5rem + 3vw, 3.25rem);
  }

  .band-signup__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.25rem, 0.75rem + 1.6vw, 2.25rem);
  }

  /* The four items are sized to fit on one row at 1440, as they do on
     the canvas, and to wrap in a sensible order below that. */
  .band-signup__intro {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 1 1 16rem;
  }
  .band-signup__disc {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--sage-700);
    color: var(--parchment-50);
  }
  .band-signup__introtext { display: block; }
  .band-signup__eyebrow {
    display: block;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--forest-900);
  }
  .band-signup__note {
    display: block;
    margin-block-start: 0.3rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--charcoal-700);
  }

  .band-signup__form {
    display: flex;
    flex: 1 1 18rem;
    max-width: 23rem;
  }
  .band-signup__field {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0.9rem 1.125rem;
    font-size: 0.875rem;
    color: var(--charcoal-800);
    background: var(--parchment-50);
    border: 1px solid var(--parchment-300);
    border-inline-end: 0;
    border-radius: 3px 0 0 3px;
  }
  .band-signup__field::placeholder { color: var(--charcoal-500); }
  .band-signup__submit {
    flex-shrink: 0;
    padding: 0.9rem 1.5rem;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--parchment-50);
    background: var(--forest-900);
    border: 0;
    border-radius: 0 3px 3px 0;
    cursor: pointer;
    transition: background-color 150ms ease;
  }
  .band-signup__submit:hover { background: var(--forest-800); }
  .band-signup__field:disabled,
  .band-signup__submit:disabled { opacity: 0.6; cursor: not-allowed; }

  .band-signup__mission { flex: 1 1 13rem; }
  .band-signup__descriptor {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--charcoal-800);
  }
  .band-signup__ask {
    margin-block-start: 0.5rem;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.78125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--hewn-700);
  }

  .band-signup__give {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-shrink: 0;
    text-decoration: none;
    color: var(--hewn-700);
  }
  .band-signup__givedisc {
    display: grid;
    place-items: center;
    width: 3.125rem;
    height: 3.125rem;
    border-radius: 50%;
    background: var(--parchment-200);
    transition: background-color 150ms ease;
  }
  .band-signup__give:hover .band-signup__givedisc { background: var(--hewn-200); }
  .band-signup__givetext {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.35;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
