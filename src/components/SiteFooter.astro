---
import { footerColumns, legalLinks, socials, copyrightLine } from "../site.config";
import SocialIcon from "./SocialIcon.astro";
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__columns">
      {footerColumns.map((col) => (
        <div class="site-footer__col">
          <h2 class="site-footer__heading">{col.heading}</h2>
          <p class="site-footer__body">{col.body}</p>
          {"socials" in col && col.socials && (
            <ul class="site-footer__socials" role="list">
              {socials.map((s) => (
                <li>
                  <a href={s.href} rel="me noopener" target="_blank">
                    <SocialIcon name={s.icon} />
                    <span class="visually-hidden">{s.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>

    <div class="site-footer__legal">
      <p class="site-footer__copyright">{copyrightLine}</p>
      <ul class="site-footer__legal-links" role="list">
        {legalLinks.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--forest-900);
    color: var(--parchment-300);
    padding-block-start: clamp(2.5rem, 1.5rem + 3vw, 3.25rem);
  }

  /* Four across on desktop, two up on tablet, one on phones.
     auto-fit rather than fixed breakpoints, so it reflows at any
     width instead of only at 1440 / 768 / 440. */
  .site-footer__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: clamp(1.75rem, 1rem + 2vw, 3.5rem);
    align-items: start;
  }

  .site-footer__heading {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--type-overline-size);
    line-height: var(--type-overline-line);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hewn-300);
    margin-block-end: 0.5rem;
  }

  .site-footer__body {
    font-size: var(--type-small-size);
    line-height: 1.5;
    color: var(--parchment-300);
    max-width: 22rem;
  }

  .site-footer__socials {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-block-start: 0.85rem;
    padding: 0;
    list-style: none;
  }
  .site-footer__socials a {
    display: inline-flex;
    color: var(--hewn-300);
    transition: color 150ms ease;
  }
  .site-footer__socials a:hover { color: var(--hewn-200); }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-block-start: clamp(1.75rem, 1rem + 2vw, 2.5rem);
    padding-block: 1.35rem 1.6rem;
    border-block-start: 1px solid color-mix(in srgb, var(--parchment-300) 20%, transparent);
  }

  .site-footer__copyright {
    font-size: var(--type-caption-size);
    line-height: 1.5;
    color: color-mix(in srgb, var(--parchment-300) 85%, transparent);
  }

  .site-footer__legal-links {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    padding: 0;
    list-style: none;
  }
  .site-footer__legal-links a {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--type-overline-size);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hewn-300);
    text-decoration: none;
  }
  .site-footer__legal-links a:hover { text-decoration: underline; }
  .site-footer__legal-links li + li::before {
    content: "·";
    margin-inline-end: 0.9rem;
    color: color-mix(in srgb, var(--parchment-300) 50%, transparent);
  }

  /* Stack the legal bar under 640px, matching the tablet and mobile
     treatment in Figma where the links sit below the copyright. */
  @media (max-width: 40rem) {
    .site-footer__legal {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
