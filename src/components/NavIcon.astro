---

<svg
  class="nav-icon"
  viewBox={icon.box}
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
><path d={icon.d} /></svg>

<style>
  /* The marks have different aspect ratios, so they are centered inside a
     square box rather than each sitting at its own width. */
  .nav-icon {
    width: var(--nav-icon-size, 1.125rem);
    height: var(--nav-icon-size, 1.125rem);
    flex-shrink: 0;
    object-fit: contain;
  }
</style>
