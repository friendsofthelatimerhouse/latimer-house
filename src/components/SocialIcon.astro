---
/**
 * Font Awesome Free 7.x brand marks, inlined as SVG rather than loaded
 * as a font or an icon library. Three icons do not justify a dependency,
 * and inline SVG inherits currentColor so it themes for free.
 *
 * Font Awesome Free is CC BY 4.0, which requires attribution. The site
 * needs an attribution line, planned for the Site Credits page.
 */
interface Props {
  name: "facebook" | "youtube" | "linkedin";
  size?: number;
}
const { name, size = 17 } = Astro.props;

const paths = {
  facebook: {
    viewBox: "0 0 320 512",
    d: "M80 299.3V512H196V299.3h86.5l18-97.8H196v-33.5c0-51.9 20.3-71.8 72.9-71.8c16.3 0 29.4 .4 37 1.2V10.6C291.4 3.5 256.4 0 236.2 0C129.3 0 80 50.5 80 159.4v42.1H14v97.8H80z",
  },
  youtube: {
    viewBox: "0 0 576 512",
    d: "M549.655 124.083c-6.281-23.65-24.787-42.276-48.284-48.597C458.781 64 288 64 288 64S117.22 64 74.629 75.486c-23.497 6.322-42.003 24.947-48.284 48.597-11.412 42.867-11.412 132.305-11.412 132.305s0 89.438 11.412 132.305c6.281 23.65 24.787 41.5 48.284 47.821C117.22 448 288 448 288 448s170.78 0 213.371-11.486c23.497-6.321 42.003-24.171 48.284-47.821 11.412-42.867 11.412-132.305 11.412-132.305s0-89.438-11.412-132.305zm-317.51 213.508V175.185l142.739 81.205-142.739 81.201z",
  },
  linkedin: {
    viewBox: "0 0 448 512",
    d: "M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z",
  },
} as const;

const icon = paths[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={icon.viewBox}
  height={size}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
><path d={icon.d} /></svg>
