---
/**
 * The forest give band. Copy Deck, Section 1.2. Appears near the foot of
 * most pages, above the newsletter band.
 *
 * The button reads HELP UNCOVER IT here because this is on the way to the
 * ask, not the ask itself. MAKE A GIFT belongs on the Give page only.
 * Copy Deck, Section 1.6.
 */
import { give } from "../site.config";
---

<section class="give-band">
  <div class="container give-band__inner">
    <div class="give-band__text" data-aos="fade-up">
      <h2 class="give-band__heading">
        There is a lot of work ahead, and we would welcome your help.
      </h2>
      <p class="give-band__body">
        Every gift goes into the house and the ground around it. Thank you.
      </p>
    </div>
    <p class="give-band__actions" data-aos="fade-up" data-aos-delay="200">
      <a class="btn btn--primary" href={give.href}>Help uncover it</a>
    </p>
  </div>
</section>

<style>
  .give-band {
    /* Sage on the canvas, not forest. It sits between a parchment band and
       the forest footer, so a third value keeps the three bands reading as
       three bands rather than two. */
    background: var(--sage-700);
    color: var(--parchment-200);
    /* 196px tall on the canvas at desktop. */
    padding-block: clamp(2.5rem, 1.75rem + 3vw, 3.75rem);
  }

  .give-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.75rem, 1rem + 2.5vw, 3.5rem);
  }

  .give-band__text { flex: 1 1 26rem; }

  .give-band__heading {
    color: var(--parchment-50);
    font-size: var(--type-h2-size);
    line-height: var(--type-h2-line);
    letter-spacing: var(--type-h2-track);
    max-width: 30ch;
  }

  .give-band__body {
    margin-block-start: 1rem;
    font-size: var(--type-lead-size);
    line-height: var(--type-lead-line);
    color: var(--parchment-300);
  }

  .give-band__actions { flex-shrink: 0; }
</style>
